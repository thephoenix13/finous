# Copy to .env.local for local work. Never commit real values to the repo; on Vercel set them under Environment Variables.
# Without the two Supabase lines the app runs as the demo only (no sign-in), which is what the tests and CI do.
VITE_SUPABASE_URL=
# The publishable (anon) key. Public by design: the database rules protect the data. Never put the service role key here.
VITE_SUPABASE_ANON_KEY=
# Where the Privacy Notice lives. Shown as a link on the beta consent screen.
VITE_PRIVACY_NOTICE_URL=
